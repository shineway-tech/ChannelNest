#!/usr/bin/env node

/* eslint-disable no-await-in-loop */

const config = require('../config');
const validateConfig = require('../config/validate');
const AiImageWorker = require('../src/workers/ai_image_worker');
const MaintenanceWorker = require('../src/workers/maintenance');

validateConfig(config);

let stopped = false;
let lastMaintenance = 0;

process.on('SIGTERM', () => { stopped = true; });
process.on('SIGINT', () => { stopped = true; });

async function sleep(milliseconds) {
  return new Promise((resolve) => {
    setTimeout(resolve, milliseconds);
  });
}

async function main() {
  while (!stopped) {
    if (Date.now() - lastMaintenance > 60 * 1000) {
      await MaintenanceWorker.run();
      lastMaintenance = Date.now();
    }
    const worked = await AiImageWorker.runOne();
    if (!worked) await sleep(1000);
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
